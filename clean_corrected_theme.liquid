    <script>
      document.addEventListener('DOMContentLoaded', function () {
        const intervalId = setInterval(() => {
          const widget = document.querySelector('.widget-visible');
          if (widget) {
            widget.style.setProperty('z-index', '1', 'important');
            clearInterval(intervalId);
          }
        }, 300);

        setTimeout(() => clearInterval(intervalId), 5000);
      });
    </script>
    <script>
      window.onload = function(e){ 
       $('.mediatype-video').trigger('click')
      }
      document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll('.thumb_media').forEach(img => {
          img.addEventListener('click', () => {
            const target = document.querySelector('.dimensions');
            if (target) {
              target.scrollIntoView({ behavior: 'smooth', block: 'start' });
              setTimeout(() => {
                if (target.getAttribute('aria-expanded') !== 'true') {
                  target.click();
                }
              }, 600);
            }
          });
        });

        document.querySelectorAll('.chart-img').forEach(img => {
          img.addEventListener('click', () => {
            const target = document.querySelector('.dimensions');
            if (target) {
              target.scrollIntoView({ behavior: 'smooth', block: 'start' });
              setTimeout(() => {
                if (target.getAttribute('aria-expanded') !== 'true') {
                  target.click();
                }
              }, 600);
            }
          });
        });

        document.addEventListener('mouseover', function (e) {
          if (!e.target.classList.contains('swatch')) return;
          const label = e.target.closest('.swatch-input__label');
          if (!label) return;
          const variantImage = label.getAttribute('data-variant_image');
          if (!variantImage) return;
          const productCard = label.closest('.product-card-wrapper');
          if (!productCard) return;
          const productImg = productCard.querySelector('.card__media img');
          if (!productImg) return;
          productImg.srcset = variantImage;
        });

        document.addEventListener('mouseout', function (e) {
          if (!e.target.classList.contains('swatch')) return;
          const label = e.target.closest('.swatch-input__label');
          if (!label) return;
          const productCard = label.closest('.product-card-wrapper');
          if (!productCard) return;
          const productImg = productCard.querySelector('.card__media img');
          if (!productImg) return;
          productImg.srcset = productImg.src;
        });

        var swiper = new Swiper('.brand-slider', {
          slidesPerView: 2,
          spaceBetween: 20,
          loop: true,
          pagination: {
            el: '.swiper-pagination',
            clickable: true,
            dynamicBullets: true,
            dynamicMainBullets: 2
          },
          breakpoints: {
            600: { slidesPerView: 2 },
            768: { slidesPerView: 5 },
            1000: { slidesPerView: 6 }
          }
        });
        
        if(document.querySelector('.facets-container.facet-wrap-main')){
          document.querySelector('.facets-container.facet-wrap-main').style.height = document.querySelector('body').clientHeight - document.querySelector('header').clientHeight - 200 + 'px'
        }
      });
    </script>

