    <script>
      document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.custom-collection-title h2').forEach(h2 => {
          const span = h2.querySelector('span');
          if (!span) return;
          var width = span.offsetWidth + 100;
          h2.style.setProperty('--span-width', `${width - 60}px`);
          h2.style.setProperty('--span-width-left', `${width - 76}px`);
        });

        if(document.querySelectorAll(".click_note")){
          const overlay = document.createElement("div");
          overlay.classList.add("popup-overlay");
          document.body.appendChild(overlay);

          document.querySelectorAll(".click_note").forEach(note => {
            note.addEventListener("click", function () {
              const popupClass = this.id.replace("popup_", "popup_");
              const popup = document.querySelector("." + popupClass);
              if (popup) {
                popup.classList.add("popup-active");
                overlay.classList.add("active");
              }
            });
          });

          overlay.addEventListener("click", function () {
            document.querySelectorAll(".popup_design").forEach(p => {
              p.classList.remove("popup-active");
            });
            overlay.classList.remove("active");
          });

          document.querySelectorAll(".close_popup").forEach(btn => {
            btn.addEventListener("click", function () {
              const popup = this.closest(".popup_design");
              if (popup) {
                popup.classList.remove("popup-active");
              }
              const overlay = document.querySelector(".popup-overlay");
              if (overlay) {
                overlay.classList.remove("active");
              }
            });
          });
        }
      });
    </script>

    <div id="scrollRoundBtn" class="scroll-round-btn" aria-label="Scroll progress / go top">
      <svg class="progress-ring" width="80" height="80" viewBox="0 0 80 80" aria-hidden="true">
        <circle class="progress-ring__circle" r="34" cx="40" cy="40" />
      </svg>
      <span class="round-inner" aria-hidden="true">
        <svg width="10" height="38" viewBox="0 0 10 20" fill="#ff4a1c" xmlns="http://www.w3.org/2000/svg">
          <path d="M10 7.21593L5 0L0 7.21186L4.33333 4.275V38H5.66667V4.275L10 7.21593Z" fill="#ff4a1c"/>
        </svg>
      </span>
    </div>

    <script>
    (function () {
      const btn = document.getElementById('scrollRoundBtn');
      if (!btn) return;

      const circle = btn.querySelector('.progress-ring__circle');
      const radius = circle.r.baseVal.value;
      const circumference = 2 * Math.PI * radius;

      circle.style.strokeDasharray = `${circumference} ${circumference}`;
      circle.style.strokeDashoffset = circumference;

      function setProgress(percent) {
        percent = Math.min(Math.max(percent, 0), 100);
        const offset = circumference - (percent / 100) * circumference;
        circle.style.strokeDashoffset = offset;
      }

      function getScrollTop() {
        return window.pageYOffset || document.documentElement.scrollTop;
      }

      function getDocHeight() {
        return document.documentElement.scrollHeight - document.documentElement.clientHeight;
      }

      function updateOnScroll() {
        const scrollTop = getScrollTop();
        const docHeight = getDocHeight();
        const pct = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
        setProgress(pct);
      }

      function goToTop() {
        btn.classList.add('pressed');
        setTimeout(() => btn.classList.remove('pressed'), 220);
        window.scrollTo({
          top: 0,
          behavior: 'smooth'
        });
      }

      btn.addEventListener('click', function (e) {
        e.preventDefault();
        goToTop();
      });

      window.addEventListener('scroll', updateOnScroll, { passive: true });
      window.addEventListener('resize', updateOnScroll);
      updateOnScroll();
    })();
    </script>
  </body>
</html>
