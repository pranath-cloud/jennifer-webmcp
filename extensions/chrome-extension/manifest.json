{
  "manifest_version": 3,
  "name": "WebMCP AI Storefront Co-Pilot",
  "version": "1.4.0",
  "description": "Agent-Native WebMCP Extension connecting Google Gemini AI to any E-Commerce Storefront.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://*/*",
    "http://localhost/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "WebMCP AI Co-Pilot"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}